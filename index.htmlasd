</head>
<body>

<a class="skip-link" href="#main">Saltar para o conteúdo</a>

<!-- ============ NAVBAR ============ -->
<header class="navbar" id="navbar">
  <div class="navbar__inner container">
    <a href="#top" class="navbar__logo" aria-label="Página inicial da NEXORA">
      <span class="logo-mark" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 15V5h1.6l7.4 6.6V5H15v10h-1.6L6 8.4V15H4z" fill="currentColor"/></svg>
      </span>
      <span>NEXORA</span>
    </a>

    <nav class="navbar__links" aria-label="Navegação principal">
      <a href="#services">Serviços</a>
      <a href="#work">Trabalhos</a>
      <a href="#process">Processo</a>
      <a href="#about">Sobre</a>
      <a href="#contact">Contacto</a>
