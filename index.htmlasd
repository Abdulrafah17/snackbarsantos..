    <a href="#contact" class="btn btn--primary btn--small navbar__cta">Começar um projeto <span aria-hidden="true">→</span></a>

    <button class="navbar__toggle" id="navToggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobileMenu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    <nav aria-label="Navegação móvel">
      <a href="#services">Serviços</a>
